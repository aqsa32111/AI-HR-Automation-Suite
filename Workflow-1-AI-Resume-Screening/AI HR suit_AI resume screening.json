        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n</head>\n\n<body style=\"margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:40px 0;background:#f4f6f9;\">\n\n<tr>\n<td align=\"center\">\n\n<table width=\"650\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.08);\">\n\n<tr>\n<td style=\"background:#1E40AF;padding:30px;text-align:center;color:white;\">\n<h1 style=\"margin:0;\">AI HR Automation Suite</h1>\n<p style=\"margin-top:8px;\">Resume Screening Report</p>\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:35px;\">\n\n<h2 style=\"color:#1E40AF;\">Congratulations {{$json.Name}}! 🎉</h2>\n\n<p style=\"font-size:15px;color:#555;line-height:1.7;\">\nWe are delighted to inform you that your profile has successfully passed the initial AI resume screening process.\n</p>\n\n<table width=\"100%\" cellpadding=\"10\" cellspacing=\"0\" style=\"border-collapse:collapse;margin-top:25px;\">\n\n<tr style=\"background:#f8fafc;\">\n<td><strong>Overall Score</strong></td>\n<td>{{$json.Score}} / 100</td>\n</tr>\n\n<tr>\n<td><strong>ATS Match</strong></td>\n<td>{{$json['ATS Match']}}%</td>\n</tr>\n\n<tr style=\"background:#f8fafc;\">\n<td><strong>Recommendation</strong></td>\n<td>{{$json.Recommendation}}</td>\n</tr>\n\n<tr>\n<td><strong>Experience Level</strong></td>\n<td>{{$json.Experience}}</td>\n</tr>\n\n</table>\n\n<h3 style=\"margin-top:30px;color:#1E40AF;\">HR Summary</h3>\n\n<p style=\"color:#555;line-height:1.8;\">\n{{$json.Summary}}\n</p>\n\n<p style=\"margin-top:25px;color:#555;\">\nOur recruitment team will carefully review your application and contact you regarding the next stage of the hiring process.\n</p>\n\n<p style=\"margin-top:40px;\">\nBest Regards,<br>\n<strong>HR Department</strong><br>\nAI HR Automation Suite\n</p>\n\n</td>\n</tr>\n\n<tr>\n<td style=\"background:#f8fafc;padding:18px;text-align:center;color:#777;font-size:13px;\">\nThis is an automated email generated by AI HR Automation Suite.\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n\n</table>\n\n</body>\n</html>",
